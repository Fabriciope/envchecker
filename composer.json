{
    "name": "fabriciope/envchecker",
    "description": "Compara o .env com o .env.example e aponta chaves faltando, sobrando ou vazias",
    "type": "library",
    "license": "MIT",
    "keywords": ["env", "dotenv", "env-example", "environment", "cli", "ci", "dev"],
    "homepage": "https://github.com/Fabriciope/envchecker",
    "authors": [
        {
            "name": "Fabrício Pereira Alves",
            "homepage": "https://fabriciopa.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Fabriciope/envchecker/issues",
        "source": "https://github.com/Fabriciope/envchecker"
    },
    "bin": ["bin/envchecker"],
    "require": {
        "php": "^8.3",
        "composer-runtime-api": "^2.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^4.0 || ^5.0",
        "symfony/var-dumper": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Fabriciope\\EnvChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest --display-warnings"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
